{
  "name": "hundun-mingpan-server",
  "version": "0.1.0",
  "description": "混沌命盘商业网站后端 API",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\" && node -e \"require('fs').cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "lunar-typescript": "^1.8.6",
    "uuid": "^10.0.0",
    "zod": "^3.23.0",
    "docx": "^9.7.1",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  }
}

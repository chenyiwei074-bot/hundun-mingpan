generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chart {
  id           String   @id @default(cuid())
  visitorId    String   @map("visitor_id")
  name         String
  gender       String
  birthData    String   @map("birth_data")
  birthPlace   String   @default("") @map("birth_place")
  currentPlace String   @default("") @map("current_place")
  chartJson    String?  @map("chart_json")
  analysisJson String?  @map("analysis_json")
  posterHtml   String?  @map("poster_html")
  posterUrl    String?  @map("poster_url")
  status       String   @default("processing")
  freeViews    Int      @default(0) @map("free_views")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("charts")
}

model ReportOrder {
  id            String   @id @default(cuid())
  chartId       String   @map("chart_id")
  email         String
  status        String   @default("pending") // pending | processing | completed | failed
  paymentStatus String   @default("unpaid") @map("payment_status") // unpaid | paid | refunded
  reportUrl     String?  @map("report_url")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("report_orders")
}

model UsageLog {
  id        String   @id @default(cuid())
  visitorId String   @map("visitor_id")
  action    String   @default("chart_create")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("usage_logs")
}

model Event {
  id        String   @id @default(cuid())
  eventName String   @map("event_name")
  visitorId String   @map("visitor_id")
  chartId   String?  @map("chart_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("events")
}
model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  phone     String?   @unique
  nickname  String?
  avatar    String?
  visitorId String    @unique @map("visitor_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  reports   Report[]

  @@map("users")
}

model Report {
  productId    String?  @map("product_id")
  product      Product? @relation(fields: [productId], references: [id])
  visitorId   String   @map("visitor_id")
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id])
  type         String   // "bazi" | "ziwei" | "liuyao"
  title        String
  inputJson    String   @map("input_json")
  resultJson   String?  @map("result_json")
  analysisJson String?  @map("analysis_json")
  reportText   String?  @map("report_text")
  status       String   @default("free") // free | paid | generated
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, type])
  @@map("reports")
}
model Product {
  id          String   @id @default(cuid())
  type        String   // "bazi" | "ziwei" | "liuyao"
  name        String
  description String?
  price       Int      @default(0) // 单位：元
  features    String   @default("[]") // JSON array of feature strings
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  reports     Report[]

  @@map("products")
}
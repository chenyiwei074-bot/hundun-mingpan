{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/fengshui/layout,_N_T_/fengshui/page,_N_T_/fengshui"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/fengshui/__PAGE__",
    "/fengshui",
    "/_index",
    "/_head"
  ]
}
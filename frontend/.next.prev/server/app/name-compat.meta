{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/name-compat/layout,_N_T_/name-compat/page,_N_T_/name-compat"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/name-compat/__PAGE__",
    "/name-compat",
    "/_index",
    "/_head"
  ]
}